# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
.eggs/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
!.env.example

# Runtime outputs (simulation results, rendered images)
outputs/

# macOS
.DS_Store
**/.DS_Store

# Editor
.vscode/settings.json
.idea/
*.swp
*.swo

# Simulation intermediates that may leak out of outputs/
*.pickle
*.ply
*.usd

# Windows-only Cairo DLLs (bundled for Windows support, unused on macOS/Linux)
pygarment/pattern/cairo_dlls/*.dll

# Redundant binary mesh format (OBJ is the primary format used by the pipeline)
*.stl

# Jupyter
.ipynb_checkpoints/

# Next.js
frontend/.next/
frontend/node_modules/
frontend/out/
