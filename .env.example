# Copy to .env and adjust for your environment.
# All variables are optional — defaults work for running from the project root.

# Path to the assets/ directory (garment_programs, bodies, design_params, Sim_props)
# GARMENT_ASSETS_PATH=assets

# Path to the body measurements YAML relative to assets_path
# GARMENT_BODY_YAML=bodies/mean_all.yaml

# Directory where simulation outputs (GLB, OBJ, PNGs) are written
# GARMENT_OUTPUT_DIR=outputs
